# Copy to `.env.local` (gitignored) and fill in real values.
#
# Product Implementation Constitution Ch.10 §3 — these are the marketing
# site's complete set of environment variables; the typed schema that reads
# them is `src/shared/env.ts`, and nothing should read `process.env` directly
# anywhere else. Names follow Ch.9 §6: <APP_PREFIX>_<SCREAMING_SNAKE_NAME>.
#
# Every value here is optional. With none of them set the contact form still
# validates submissions and reports success, logging server-side that nothing
# was delivered — so the app builds, tests, and runs without any secret.

# Resend API key. https://resend.com/api-keys
MARKETING_SITE_RESEND_API_KEY=

# Destination address for validated contact-form submissions.
MARKETING_SITE_CONTACT_INBOX_EMAIL=

# Envelope sender. Resend rejects any `from` whose domain is not verified in
# the account, so leave this unset to use the built-in default
# ("Trady Perch site <onboarding@resend.dev>") — Resend's shared test sender,
# which needs no domain verification but can only deliver to the Resend
# account owner's own address.
#
# Once tradyperch.com is verified in the Resend dashboard, set this to
# "Trady Perch site <contact@tradyperch.com>" to send from the real domain.
# No code change is required.
MARKETING_SITE_RESEND_FROM_EMAIL=

# --- Telegram lead alerts ---------------------------------------------------
#
# The contact form's second delivery channel. An enquiry goes to the inbox
# above as the record, and to a Telegram chat as the alert, so a lead is seen
# in minutes rather than whenever the inbox is next opened.
#
# The two channels are dispatched in parallel and judged together: either one
# arriving means the enquiry reached a human. A Telegram outage can never turn
# a delivered email into an error for the visitor, and vice versa.
#
# Both are optional and inert unless BOTH are set. Neither carries a
# NEXT_PUBLIC_ prefix, which is the only mechanism by which Next.js would
# inline a value into the browser bundle — see src/shared/env.ts.

# BotFather token for the bot that posts the alert. This is a full credential:
# anyone holding it can send and read everything the bot can. Rotate it with
# /revoke in BotFather if it is ever pasted somewhere it should not be.
MARKETING_SITE_TELEGRAM_BOT_TOKEN=

# The chat the alert is posted to — a personal chat, a group, or a channel.
# Get it by messaging the bot once and reading `result[0].message.chat.id` from
# https://api.telegram.org/bot<TOKEN>/getUpdates
#
# The bot cannot message a person who has never started a chat with it, so
# press Start once before expecting the first alert.
MARKETING_SITE_TELEGRAM_CHAT_ID=

# --- GitHub portfolio feed (/work/projects) ---------------------------------
#
# The Work section reads this account's public repositories at build time and
# hourly thereafter. Push a new repository and it appears on the site within
# the hour, with a generated case study page at /work/projects/<repo-name> —
# no code change, no deploy.
#
# Both variables are optional and the app builds, tests and runs without
# either: absent, the projects grid renders its empty state. Neither carries a
# NEXT_PUBLIC_ prefix, which is the only mechanism by which Next.js would
# inline a value into the browser bundle — see src/shared/env.ts.

# The GitHub account (user or organisation) whose public repositories are
# published as portfolio projects.
MARKETING_SITE_GITHUB_USERNAME=

# Fine-grained or classic personal access token with PUBLIC REPOSITORY READ
# scope only. Nothing here needs write access to anything.
#
# Optional, with two consequences if omitted:
#   - The REST rate limit drops from 5,000 requests/hour to 60, which is still
#     ample for an hourly revalidation but tight for local development.
#   - The contribution graph, streak and yearly contribution total disappear.
#     They come from GitHub's GraphQL API, which requires authentication
#     unconditionally — there is no unauthenticated tier to fall back to.
MARKETING_SITE_GITHUB_TOKEN=
